<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET só para o Atualizador consultar e baixar as releases do GitHub:
         nenhum dado sai do celular. A instalação a pessoa libera uma vez. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- allowBackup=false: o backup automático do Google não leva os dados. -->
    <application
        android:name=".FrenteFriaApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/sem_backup"
        android:icon="@mipmap/ic_clima"
        android:label="Frente Fria"
        android:theme="@style/Theme.FrenteFria">

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- O ícone do launcher: um alias por modo, só um ligado (Icone.kt). -->
        <activity-alias
            android:name=".IconeClima"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_clima"
            android:label="Frente Fria"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconeDireto"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_direto"
            android:label="Frente Fria"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".avisos.ComecouReceiver"
            android:exported="false" />

        <!-- Resposta do Android à instalação de uma versão nova. -->
        <receiver
            android:name=".atualizacao.InstalacaoReceiver"
            android:exported="false" />
    </application>
</manifest>
